{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "hugo",
  "frontMatter.framework.startCommand": "hugo server -D",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.content.pageFolders": [
    {
      "title": "Blog",
      "path": "[[workspace]]/content/blog",
      "excludeSubdir": false
    }
  ],
  "frontMatter.taxonomy.frontMatterType": "YAML",
  "frontMatter.taxonomy.dateFormat": "yyyy-MM-dd'T'HH:mm:ssxxx",
  "frontMatter.content.draftField": {
    "name": "draft",
    "type": "boolean"
  },
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": true,
      "previewPath": "blog",
      "fields": [
        { "title": "Title", "name": "title", "type": "string", "required": true },
        { "title": "Description", "name": "description", "type": "string" },
        { "title": "Date", "name": "date", "type": "datetime", "default": "{{now}}", "isPublishDate": true },
        { "title": "Last modified", "name": "lastmod", "type": "datetime", "isModifiedDate": true },
        { "title": "Draft", "name": "draft", "type": "draft", "default": true },
        { "title": "Tags", "name": "tags", "type": "tags" },
        { "title": "Show TOC", "name": "showTableOfContents", "type": "boolean" }
      ]
    }
  ]
}
